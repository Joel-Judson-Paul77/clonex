# Copy to .env.local (never commit real values)

# n8n cloud production webhook for the BrandGuard alert workflow
# e.g. https://YOUR-INSTANCE.app.n8n.cloud/webhook/brandguard-alert
N8N_WEBHOOK_URL=

# Optional: enables AI scam-intent analysis and takedown drafting
ANTHROPIC_API_KEY=

# Required to enable /api/notify (n8n alerts). Callers must send it as the "x-clonex-key" header.
CLONEX_NOTIFY_KEY=

# --- Takedown dispatch (the "Initiate Takedown" button -> n8n) ---
# Production webhook of the "CloneX - Takedown Dispatch" workflow (n8n/clonex-takedown.workflow.json).
# Falls back to N8N_WEBHOOK_URL if empty. With neither set, dispatching is a harmless dry run.
N8N_TAKEDOWN_WEBHOOK_URL=
# Optional shared secret, sent to n8n as the "x-clonex-secret" header (pair it with Header Auth on the webhook).
N8N_WEBHOOK_SECRET=
# "demo" (default): every notice goes to CLONEX_DEMO_INBOX, never to a platform. "live": notices go to the
# platform's abuse desk. Simulated demo items are refused in live mode.
CLONEX_TAKEDOWN_MODE=demo
# Your own test inbox for demo mode. Empty = the workflow saves a Gmail draft instead of sending.
CLONEX_DEMO_INBOX=
